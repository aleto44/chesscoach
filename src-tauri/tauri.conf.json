{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chess Coach",
  "version": "0.2.0",
  "identifier": "com.alexj.chesscoach",
  "build": {
    "frontendDist": "fallback"
  },
  "app": {
    "windows": [
      {
        "title": "Chess Coach",
        "width": 1360,
        "height": 860,
        "minWidth": 1000,
        "minHeight": 640,
        "create": false,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
